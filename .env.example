# ---------------------------------------------------------------------------
# PAYSTACK KEYS  ->  get them from: Paystack Dashboard > Settings > API Keys
# Put this file at the ROOT of the project as ".env.local" (it is git-ignored).
# On Vercel: Project > Settings > Environment Variables  (add both there)
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_live_PASTE_YOUR_SECRET_KEY_HERE
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_PASTE_YOUR_PUBLIC_KEY_HERE

# The public URL of the site once deployed (no trailing slash)
# Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
